# ruxen as a systemd service.
#
#   install -m 755 ruxen /usr/local/bin/ruxen
#   install -D -m 644 your.conf /etc/ruxen/ruxen.conf
#   install -m 644 contrib/systemd/ruxen.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ruxen
#
# Use absolute paths in the configuration (root, access_log, …): the
# working directory is /. Files ruxen writes go to the directories systemd
# creates for the service: /var/log/ruxen (access_log, error_log),
# /var/cache/ruxen (client_body_temp_path), /run/ruxen (pid).

[Unit]
Description=ruxen web server
Documentation=https://github.com/gvozdetsky/ruxen
After=network-online.target
Wants=network-online.target

[Service]
# ruxen stays in the foreground (it ignores `daemon`), so no forking and
# no PIDFile. Its stderr, where error_log goes by default, is the journal.
# It tells systemd when it accepts (READY=1), around a reload
# (RELOADING=1, READY=1) and when it stops (STOPPING=1).
Type=notify
# The watchdog: ruxen answers it only while every worker makes progress,
# so a worker stuck in a busy loop or a blocking call (a hung NFS mount, a
# FIFO) gets ruxen restarted, with an alert in the error log.
WatchdogSec=30s
ExecStartPre=/usr/local/bin/ruxen -t -q -c /etc/ruxen/ruxen.conf
ExecStart=/usr/local/bin/ruxen -c /etc/ruxen/ruxen.conf
# SIGHUP reloads the configuration without dropping connections, as
# `ruxen -s reload`. Check it first: a configuration that fails is logged
# and the running one stays.
ExecReload=/usr/local/bin/ruxen -t -q -c /etc/ruxen/ruxen.conf
ExecReload=/bin/kill -HUP $MAINPID
# SIGQUIT is the graceful stop: requests in flight finish, within
# worker_shutdown_timeout if the configuration sets one. systemd sends
# SIGKILL after TimeoutStopSec.
KillSignal=SIGQUIT
TimeoutStopSec=30s
Restart=on-failure
RestartSec=2s

# An unprivileged user made for the service, allowed to bind ports below
# 1024. ruxen then needs no `user` directive: it applies only when ruxen
# starts as root, and is ignored with a warning otherwise.
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LogsDirectory=ruxen
CacheDirectory=ruxen
RuntimeDirectory=ruxen
# Raise it for many connections; worker_rlimit_nofile can't go above it.
LimitNOFILE=65536
# Each worker's io_uring ring, about 0.5 MiB, counts against it on
# Linux 7.0, and a reload holds the old workers' rings for a while: the
# default 8 MiB fits about 16 workers.
LimitMEMLOCK=128M

# Hardening. ruxen runs on io_uring: the system-call filter has to let
# io_uring_setup, io_uring_enter and io_uring_register through. Recent
# systemd has them in @aio, part of @system-service; they are listed
# anyway.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
