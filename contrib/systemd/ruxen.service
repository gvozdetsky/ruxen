# ruxen as a systemd service.
#
#   install -m 755 ruxen /usr/local/bin/ruxen
#   install -D -m 644 your.conf /etc/ruxen/ruxen.conf
#   install -m 644 contrib/systemd/ruxen.service /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now ruxen
#
# Use absolute paths in the configuration (root, access_log, …): the
# working directory is /. Files ruxen writes go to the directories systemd
# creates for the service: /var/log/ruxen (access_log, error_log),
# /var/cache/ruxen (client_body_temp_path), /run/ruxen (pid).

[Unit]
Description=ruxen web server
Documentation=https://github.com/gvozdetsky/ruxen
After=network-online.target
Wants=network-online.target

[Service]
# ruxen stays in the foreground (it ignores `daemon`), so no forking and
# no PIDFile. Its stderr, where error_log goes by default, is the journal.
Type=exec
ExecStartPre=/usr/local/bin/ruxen -t -q -c /etc/ruxen/ruxen.conf
ExecStart=/usr/local/bin/ruxen -c /etc/ruxen/ruxen.conf
# SIGUSR1 reopens the log files, for logrotate. ruxen can't re-read its
# configuration yet (`-s reload`, issue #89): restart it to apply a change.
ExecReload=/bin/kill -USR1 $MAINPID
# SIGQUIT is the graceful stop: requests in flight finish, within
# worker_shutdown_timeout if the configuration sets one. systemd sends
# SIGKILL after TimeoutStopSec.
KillSignal=SIGQUIT
TimeoutStopSec=30s
Restart=on-failure
RestartSec=2s

# An unprivileged user made for the service, allowed to bind ports below
# 1024. ruxen then needs no `user` directive (which it doesn't support
# yet; started as root without `user root;` it refuses to run).
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LogsDirectory=ruxen
CacheDirectory=ruxen
RuntimeDirectory=ruxen
# Raise it for many connections; worker_rlimit_nofile can't go above it.
LimitNOFILE=65536

# Hardening. ruxen runs on io_uring: the system-call filter has to let
# io_uring_setup, io_uring_enter and io_uring_register through. Recent
# systemd has them in @aio, part of @system-service; they are listed
# anyway.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service io_uring_setup io_uring_enter io_uring_register
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
